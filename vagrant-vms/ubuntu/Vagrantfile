# -*- mode: ruby -*-
# vi: set ft=ruby :

# Toute la configuration Vagrant se fait ci-dessous.
# Le "2" dans Vagrant.configure indique la version de la configuration.
# Nous conservons la compatibilité avec les anciennes versions.
# Ne le modifiez pas sauf si vous savez exactement ce que vous faites.
Vagrant.configure("2") do |config|

  # Les options de configuration les plus courantes sont documentées
  # et commentées ci-dessous.
  # Pour une référence complète, consultez la documentation officielle :
  # https://docs.vagrantup.com.

  # Chaque environnement de développement Vagrant nécessite une box.
  # Vous pouvez rechercher des boxes sur :
  # https://vagrantcloud.com/search.
  # Ici, nous utilisons Ubuntu 22.04 LTS (Jammy Jellyfish) en version 64 bits.
  config.vm.box = "ubuntu/jammy64"

  # Désactive la vérification automatique des mises à jour de la box.
  # Si cette option est désactivée, les mises à jour seront vérifiées
  # uniquement lors de l’exécution de la commande `vagrant box outdated`.
  # Ce n’est généralement pas recommandé.
  # config.vm.box_check_update = false

  # Création d’une redirection de port :
  # Permet d’accéder à un port de la machine virtuelle
  # depuis un port de la machine hôte.
  # Exemple : accéder à localhost:8080 (hôte) redirige vers le port 80 de la VM.
  # ATTENTION : cela rend le port accessible publiquement.
  # config.vm.network "forwarded_port", guest: 80, host: 8080

  # Redirection de port limitée à l’adresse locale (127.0.0.1).
  # Cela empêche l’accès depuis l’extérieur du poste hôte.
  # config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"

  # Création d’un réseau privé (host-only).
  # Permet uniquement la communication entre la machine hôte
  # et la machine virtuelle, avec une adresse IP fixe.
  config.vm.network "private_network", ip: "192.168.33.10"

  # Création d’un réseau public (bridged).
  # La machine virtuelle apparaît comme un appareil
  # à part entière sur le réseau local.
  config.vm.network "public_network", bridged: "en0: Ethernet"

  # Partage d’un dossier supplémentaire entre l’hôte et la machine virtuelle.
  # Le premier chemin correspond au dossier sur l’hôte,
  # le second au point de montage dans la VM.
  # Le troisième paramètre (optionnel) permet d’ajouter des options avancées.
  # config.vm.synced_folder "../data", "/vagrant_data"

  # Désactive le partage par défaut du dossier courant du projet.
  # Cela améliore l’isolation entre l’hôte et la machine virtuelle
  # en évitant que le Vagrantfile soit accessible dans la VM.
  # Si cette option est activée, vous devrez définir
  # manuellement d’autres dossiers partagés.
  # config.vm.synced_folder ".", "/vagrant", disabled: true

  # Configuration spécifique au provider utilisé (ici VirtualBox).
  # Ces options permettent d’ajuster les paramètres de la machine virtuelle.
  #
  config.vm.provider "virtualbox" do |vb|
  # Afficher l’interface graphique de VirtualBox au démarrage
  # vb.gui = true

    # Quantité de mémoire RAM allouée à la machine virtuelle (en Mo)
    vb.memory = "1024"

    # Nombre de processeurs alloués à la machine virtuelle
    vb.cpus = 2
  end
  #
  # Consultez la documentation du provider utilisé
  # pour plus d’options disponibles.

  # Activation du provisioning avec un script shell.
  # Cela permet d’exécuter automatiquement des commandes
  # lors de la création ou du démarrage de la machine virtuelle.
  # Des provisioners plus avancés sont disponibles :
  # Ansible, Chef, Docker, Puppet, Salt, etc.
  #
  # Exemple : mise à jour du système et installation d’Apache.
  # config.vm.provision "shell", inline: <<-SHELL
  #   apt-get update
  #   apt-get install -y apache2
  # SHELL

end
