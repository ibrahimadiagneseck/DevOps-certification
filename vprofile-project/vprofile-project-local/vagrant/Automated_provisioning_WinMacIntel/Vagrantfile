Vagrant.configure("2") do |config|
  # =============================================
  # CONFIGURATION GLOBALE
  # =============================================
  
  # Configuration du plugin vagrant-hostmanager
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true
  config.hostmanager.manage_guest = true  # Décommenté pour gérer les hosts des machines invitées
  
  # Configuration VirtualBox globale
  config.vm.provider "virtualbox" do |vb|
    vb.gui = false  # Désactive l'interface graphique par défaut
  end

  # =============================================
  # MACHINE DB01 - SERVEUR DE BASE DE DONNÉES
  # =============================================
  config.vm.define "db01" do |db01|
    db01.vm.box = "centos/stream9"
    db01.vm.hostname = "db01"
    
    # Configuration réseau
    db01.vm.network "private_network", ip: "192.168.56.15"
    
    # Configuration VirtualBox
    db01.vm.provider "virtualbox" do |vb|
      vb.name = "db01-mysql-server"
      vb.memory = "1024"
      vb.cpus = "1"
    end
    
    # Provisioning
    db01.vm.provision "shell", path: "./mysql.sh"
    
    # Synchronisation de dossiers
    db01.vm.synced_folder "./database/backups", "/backups"
  end

  # =============================================
  # MACHINE MC01 - SERVEUR MEMCACHED
  # =============================================
  config.vm.define "mc01" do |mc01|
    mc01.vm.box = "centos/stream9"
    mc01.vm.hostname = "mc01"
    
    mc01.vm.network "private_network", ip: "192.168.56.14"
    
    mc01.vm.provider "virtualbox" do |vb|
      vb.name = "mc01-memcached"
      vb.memory = "512"
      vb.cpus = "1"
    end
    
    mc01.vm.provision "shell", path: "./memcache.sh"
  end

  # =============================================
  # MACHINE RMQ01 - SERVEUR RABBITMQ
  # =============================================
  config.vm.define "rmq01" do |rmq01|
    rmq01.vm.box = "centos/stream9"
    rmq01.vm.hostname = "rmq01"
    
    rmq01.vm.network "private_network", ip: "192.168.56.16"
    
    rmq01.vm.provider "virtualbox" do |vb|
      vb.name = "rmq01-rabbitmq"
      vb.memory = "1024"
      vb.cpus = "1"
    end
    
    rmq01.vm.provision "shell", path: "./rabbitmq.sh"
  end

  # =============================================
  # MACHINE APP01 - SERVEUR D'APPLICATION TOMCAT
  # =============================================
  config.vm.define "app01" do |app01|
    app01.vm.box = "centos/stream9"
    app01.vm.hostname = "app01"
    
    app01.vm.network "private_network", ip: "192.168.56.12"
    
    app01.vm.provider "virtualbox" do |vb|
      vb.name = "app01-tomcat"
      vb.memory = "2048"
      vb.cpus = "2"
    end
    
    app01.vm.provision "shell", path: "./tomcat.sh"
    
    # Port forwarding pour accéder à Tomcat depuis l'hôte
    app01.vm.network "forwarded_port", guest: 8080, host: 8081
  end

  # =============================================
  # MACHINE WEB01 - SERVEUR WEB NGINX
  # =============================================
  config.vm.define "web01" do |web01|
    web01.vm.box = "ubuntu/jammy64"
    web01.vm.hostname = "web01"
    
    web01.vm.network "private_network", ip: "192.168.56.11"
    
    web01.vm.provider "virtualbox" do |vb|
      vb.name = "web01-nginx"
      vb.gui = false           # Désactivé pour meilleures performances
      vb.memory = "1024"
      vb.cpus = "1"
    end
    
    web01.vm.provision "shell", path: "./nginx.sh"
    
    # Port forwarding
    web01.vm.network "forwarded_port", guest: 80, host: 8080
    web01.vm.network "forwarded_port", guest: 443, host: 8443
  end
end